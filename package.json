{
  "name": "hugo-theme-glyco",
  "version": "1.0.0",
  "description": "Glyco hugo theme",
  "scripts": {
    "build": ". ./.env.prod; ./node_modules/.bin/webpack --config webpack.prod.conf.js",
    "build-watch-web": "./node_modules/.bin/webpack --watch --config webpack.dev.conf.js",
    "start": ". ./.env.dev; ./node_modules/.bin/webpack --watch --config webpack.dev.conf.js",
    "deploy": "rm -rf dist && ./node_modules/.bin/webpack --config webpack.prod.conf.js && ./deploy.sh prod"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:hirenj/hugo-theme-glyco.git"
  },
  "author": "hirenj@gmail.com",
  "license": "MIT",
  "dependencies": {
    "glycan.js": "github:hirenj/glycan.js",
    "mascp-jstools": "github:hirenj/mascp-jstools#nolegacy",
    "sviewer": "github:hirenj/sviewer",
    "summary-protviewer": "github:hirenj/summary-protviewer.js",
    "@babel/core": "^7",
    "@babel/preset-env": "^7.4.4",
    "babel-loader": "^8.0.5",
    "compression-webpack-plugin": "^12.0.0",
    "core-js": "3",
    "css-loader": "^6.11.0",
    "fs-extra": "^9.1.0",
    "object.fromentries": "^2.0.1",
    "raw-loader": "^4.0.2",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  }
}
